# Copy to `.env` and fill in. Never commit `.env`.

# Optional — enables Claude-polished, multilingual chat replies on /api/query.
# Without this, a deterministic template response from the local NLG is used.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional override for the server port (Render injects PORT automatically).
# PORT=8000
